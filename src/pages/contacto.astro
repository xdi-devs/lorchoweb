---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Contacto — GB Lorchos"
  description="Ponte en contacto co GB Lorchos. Únete ao club, solicita información ou colabora connosco."
>

  <!-- Hero -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 hero-grid opacity-40"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow justify-center">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
        Estamos aquí
      </span>
      <h1 class="font-display font-900 uppercase text-white leading-none mt-2"
          style="font-size: clamp(3.5rem, 8vw, 7rem);">
        Fala<br/>
        <span class="text-gradient-cyan">connosco</span>
      </h1>
      <p class="section-subtitle mx-auto max-w-lg mt-4">
        Queres unirte, colaborar ou simplemente saber máis sobre o fútbol gaélico en Galicia?
        Escríbenos. Respondemos en menos de 24 horas.
      </p>
    </div>
  </section>

  <!-- Content grid -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12">

        <!-- Contact form (3 cols) -->
        <div class="lg:col-span-3">
          <div class="glass-card glow-card-cyan p-8 lg:p-10">
            <h2 class="font-display font-800 text-white uppercase text-3xl mb-8">Envíanos unha mensaxe</h2>

            <form id="contact-form" class="flex flex-col gap-6" novalidate>
              <!-- Name + Email -->
              <div class="grid sm:grid-cols-2 gap-5">
                <div class="flex flex-col gap-2">
                  <label for="name" class="text-xs font-mono text-brand-muted uppercase tracking-widest">
                    Nome *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="O teu nome"
                    class="form-input"
                  />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="email" class="text-xs font-mono text-brand-muted uppercase tracking-widest">
                    Email *
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="ti@exemplo.com"
                    class="form-input"
                  />
                </div>
              </div>

              <!-- Subject -->
              <div class="flex flex-col gap-2">
                <label for="subject" class="text-xs font-mono text-brand-muted uppercase tracking-widest">
                  Asunto
                </label>
                <select id="subject" name="subject" class="form-input">
                  <option value="">Selecciona un motivo</option>
                  <option value="unirse">Quero unirme ao club</option>
                  <option value="info">Información xeral</option>
                  <option value="patrocinio">Patrocinio / Colaboración</option>
                  <option value="prensa">Prensa / Medios</option>
                  <option value="outro">Outro</option>
                </select>
              </div>

              <!-- Team interest -->
              <div class="flex flex-col gap-3">
                <span class="text-xs font-mono text-brand-muted uppercase tracking-widest">
                  Interésame o equipo
                </span>
                <div class="flex flex-wrap gap-3">
                  {[
                    { id: 'team-m', value: 'lorchos', label: 'GB Lorchos (Masculino)', color: 'cyan' },
                    { id: 'team-f', value: 'lorchas', label: 'GB Lorchas (Feminino)',  color: 'orange' },
                    { id: 'team-b', value: 'ambos',   label: 'Os dous',               color: 'white' },
                  ].map(({ id, value, label, color }) => (
                    <label
                      for={id}
                      class={`flex items-center gap-2 cursor-pointer px-4 py-2.5 rounded-xl border transition-all duration-200
                        ${color === 'cyan'   ? 'border-brand-cyan/20 hover:border-brand-cyan/50 hover:bg-brand-cyan/5'   : ''}
                        ${color === 'orange' ? 'border-brand-orange/20 hover:border-brand-orange/50 hover:bg-brand-orange/5' : ''}
                        ${color === 'white'  ? 'border-white/10 hover:border-white/20 hover:bg-white/5' : ''}
                      `}
                    >
                      <input type="radio" id={id} name="team" value={value} class="sr-only" />
                      <span class={`w-3 h-3 rounded-full border-2 team-radio-dot
                        ${color === 'cyan'   ? 'border-brand-cyan'   : ''}
                        ${color === 'orange' ? 'border-brand-orange' : ''}
                        ${color === 'white'  ? 'border-white/40'     : ''}
                      `}></span>
                      <span class={`text-sm font-medium
                        ${color === 'cyan'   ? 'text-brand-cyan'   : ''}
                        ${color === 'orange' ? 'text-brand-orange' : ''}
                        ${color === 'white'  ? 'text-white/70'     : ''}
                      `}>{label}</span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Message -->
              <div class="flex flex-col gap-2">
                <label for="message" class="text-xs font-mono text-brand-muted uppercase tracking-widest">
                  Mensaxe *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Cóntanos o que necesitas..."
                  class="form-input resize-none"
                ></textarea>
              </div>

              <!-- Privacy -->
              <label class="flex items-start gap-3 cursor-pointer group">
                <input type="checkbox" id="privacy" name="privacy" required class="sr-only" />
                <div id="privacy-box" class="mt-0.5 w-5 h-5 shrink-0 rounded-md border border-white/20 group-hover:border-brand-cyan/40 transition-colors flex items-center justify-center">
                  <svg id="privacy-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-brand-cyan hidden">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
                <span class="text-xs text-brand-muted leading-relaxed">
                  Acepto a <a href="/privacidade" class="text-brand-cyan hover:underline">política de privacidade</a> e consinto que GB Lorchos procese os meus datos para responder á miña consulta.
                </span>
              </label>

              <!-- Submit -->
              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full justify-center mt-2 py-4 text-base"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Enviar mensaxe
              </button>

              <!-- Success message -->
              <div id="success-msg" class="hidden flex items-center gap-3 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-sm font-medium">Mensaxe enviada. Respondemos en breve!</span>
              </div>
            </form>
          </div>
        </div>

        <!-- Sidebar (2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

          <!-- Info cards -->
          {[
            {
              icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
              title: 'Localización',
              lines: ['Campo de fútbol de Bealo', 'Bealo, Boiro, Galicia'],
              accent: 'cyan',
            },
            {
              icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
              title: 'Adestramentos',
              lines: ['Luns, mércores e venres', '20:00 – 22:00 h'],
              accent: 'cyan',
            },
            {
              icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
              title: 'Email',
              lines: ['info@gblorchos.gal'],
              accent: 'orange',
              link: 'mailto:info@gblorchos.gal',
            },
          ].map(({ icon, title, lines, accent, link }) => (
            <div class={`glass-card p-6 border ${accent === 'cyan' ? 'border-brand-cyan/10' : 'border-brand-orange/10'}`}>
              <div class="flex items-start gap-4">
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${accent === 'cyan' ? 'bg-brand-cyan/10 text-brand-cyan' : 'bg-brand-orange/10 text-brand-orange'}`}
                     set:html={icon}>
                </div>
                <div>
                  <p class={`text-xs font-mono uppercase tracking-widest mb-1 ${accent === 'cyan' ? 'text-brand-cyan' : 'text-brand-orange'}`}>{title}</p>
                  {lines.map(line => (
                    <p class="text-sm text-white font-medium">
                      {link ? <a href={link} class="hover:text-brand-cyan transition-colors">{line}</a> : line}
                    </p>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <!-- Social links -->
          <div class="glass-card p-6">
            <p class="text-xs font-mono text-brand-muted uppercase tracking-widest mb-5">Síguenos</p>
            <div class="flex flex-col gap-3">
              {[
                {
                  href: 'https://instagram.com/gblorchos',
                  icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
                  label: 'Instagram',
                  handle: '@gb.lorchos',
                },
                {
                  href: 'https://youtube.com/@gblorchos',
                  icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>`,
                  label: 'YouTube',
                  handle: '@gblorchos',
                },
                {
                  href: 'https://whatsapp.com/channel/gblorchos',
                  icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
                  label: 'Canal WhatsApp',
                  handle: 'GB Lorchos Canal',
                },
              ].map(({ href, icon, label, handle }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all duration-200 group"
                >
                  <span class="text-brand-muted group-hover:text-brand-cyan transition-colors" set:html={icon}></span>
                  <div>
                    <div class="text-sm font-semibold text-white">{label}</div>
                    <div class="text-xs text-brand-muted">{handle}</div>
                  </div>
                  <svg class="ml-auto text-brand-muted/30 group-hover:text-brand-cyan/50 transition-colors" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .form-input {
    @apply w-full px-4 py-3.5 rounded-xl
           bg-brand-slate border border-white/10
           text-white placeholder-brand-muted/50
           text-sm font-body
           focus:outline-none focus:border-brand-cyan/50 focus:ring-1 focus:ring-brand-cyan/20
           transition-all duration-200;
  }
  select.form-input option {
    background: #0d1520;
    color: white;
  }
</style>

<script>
  // Custom checkbox
  const privacyInput = document.getElementById('privacy') as HTMLInputElement;
  const privacyBox   = document.getElementById('privacy-box');
  const privacyCheck = document.getElementById('privacy-check');

  document.querySelector('label[for="privacy"]')?.addEventListener('click', () => {
    if (!privacyInput) return;
    privacyInput.checked = !privacyInput.checked;
    if (privacyInput.checked) {
      privacyBox?.classList.add('border-brand-cyan', 'bg-brand-cyan/10');
      privacyCheck?.classList.remove('hidden');
    } else {
      privacyBox?.classList.remove('border-brand-cyan', 'bg-brand-cyan/10');
      privacyCheck?.classList.add('hidden');
    }
  });

  // Form submit (demo - no backend)
  const form       = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    // Simulate send
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    await new Promise(r => setTimeout(r, 1200));
    submitBtn.classList.add('hidden');
    successMsg?.classList.remove('hidden');
    form.reset();
    privacyBox?.classList.remove('border-brand-cyan', 'bg-brand-cyan/10');
    privacyCheck?.classList.add('hidden');
  });
</script>
