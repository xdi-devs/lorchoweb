---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Button from '../components/Button.astro';

const milestones = [
  {
    year: '2023',
    title: 'Nacemento do Club',
    text: 'Un grupo de apaixonados do fútbol gaélico en Boiro decide fundar o primeiro club de fútbol gaélico da comarca do Barbanza. Co apoio inicial da Asociación Galega e a forza de todo un pobo, nace GB Lorchos.',
    side: 'left',
    accent: 'cyan',
  },
  {
    year: '2023',
    title: 'Primeira Competición',
    text: 'O equipo disputa os seus primeiros partidos oficiais nun torneo a 7 na Estrada. Aínda sen experiencia, a entrega e o compañeirismo convértense nos piares dun proxecto que xa soñaba con algo máis grande.',
    side: 'right',
    accent: 'orange',
  },
    {
    year: '2025',
    title: 'Primeiro Título',
    text: 'O equipo masculino conquista por primeira vez a Copa Shield, nun partido disputado contra Lume de Beltane.',
    side: 'left',
    accent: 'cyan',
  },
  {
    year: '2025',
    title: 'Creación do Equipo Feminino',
    text: 'Nace GB Lorchas, o equipo feminino do club. Un fito histórico que converte ao GB Lorchos nun dos poucos clubes galegos con representación masculina e feminina no fútbol gaélico.',
    side: 'right',
    accent: 'orange',
  },
];
---

<BaseLayout
  title="Historia do Club — GB Lorchos"
  description="Coñece a historia do GB Lorchos, o club de fútbol gaélico do Barbanza. Dende as nosas orixes en 2023 ata o presente."
>

  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 hero-grid opacity-30"></div>
    <div class="absolute inset-0"
         style="background: radial-gradient(ellipse at 50% 80%, rgba(245,138,32,0.06) 0%, transparent 60%)">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-eyebrow justify-center">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-pulse"></span>
        Dende 2023
      </span>
      <h1 class="font-display font-900 uppercase text-white leading-none mt-2"
          style="font-size: clamp(3.5rem, 8vw, 7rem);">
        A nosa<br/>
        <span class="text-gradient-orange">Historia</span>
      </h1>
      <p class="section-subtitle mx-auto max-w-xl mt-6">
        Unha historia de paixón, sacrificio e amor polo fútbol gaélico que naceu nun bar de Boiro
        e hoxe compite cos mellores de Galicia.
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card glow-card-orange p-10 lg:p-14 text-center">
        <p class="text-lg text-white/80 leading-relaxed font-light">
          O <strong class="text-white font-semibold">GB Lorchos</strong> é máis que un club de fútbol gaélico.
          É a demostración de que Galicia e Irlanda comparten algo profundo: a paixón pola terra,
          pola lingua e polo deporte como forma de vida. Somos Lorchos feitos equipo.
        </p>
        <div class="mt-8 flex items-center justify-center gap-3">
          <div class="h-px flex-1 bg-gradient-to-r from-transparent to-brand-orange/30"></div>
          <span class="font-display font-700 text-brand-orange uppercase tracking-widest text-sm">Barbanza · Galicia</span>
          <div class="h-px flex-1 bg-gradient-to-l from-transparent to-brand-orange/30"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-16">
        <SectionTitle
          eyebrow="Cronoloxía"
          title="Fitos do Club"
          highlight="Fitos"
          align="center"
        />
      </div>

      <!-- Timeline container -->
      <div class="relative">
        <!-- Center vertical line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 hidden md:block"
             style="background: linear-gradient(to bottom, transparent, rgba(0,205,255,0.3) 10%, rgba(0,205,255,0.3) 90%, transparent)">
        </div>

        <div class="flex flex-col gap-12">
          {milestones.map((m, i) => (
            <div class={`reveal relative flex flex-col md:flex-row gap-8 md:gap-0 items-start md:items-center animate-delay-${(i % 4 + 1) * 100}`}>

              <!-- Left content (odd) -->
              <div class={`md:w-1/2 ${m.side === 'left' ? 'md:pr-16 md:text-right' : 'md:opacity-0 md:pointer-events-none md:pr-16'}`}>
                {m.side === 'left' && (
                  <div class={`glass-card p-7 border ${m.accent === 'cyan' ? 'border-brand-cyan/20 hover:border-brand-cyan/40' : 'border-brand-orange/20 hover:border-brand-orange/40'} transition-all duration-300`}>
                    <div class={`text-5xl font-display font-900 leading-none mb-2 ${m.accent === 'cyan' ? 'text-gradient-cyan' : 'text-gradient-orange'}`}>
                      {m.year}
                    </div>
                    <h3 class="font-display font-800 text-white uppercase text-2xl mb-3">{m.title}</h3>
                    <p class="text-sm text-brand-muted leading-relaxed">{m.text}</p>
                  </div>
                )}
              </div>

              <!-- Center dot -->
              <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 z-10 items-center justify-center">
                <div class={`w-5 h-5 rounded-full border-2 ${m.accent === 'cyan' ? 'bg-brand-cyan border-brand-cyan shadow-cyan' : 'bg-brand-orange border-brand-orange shadow-orange'}`}></div>
              </div>

              <!-- Mobile year badge -->
              <div class={`md:hidden flex items-center gap-3 ${m.accent === 'cyan' ? 'text-brand-cyan' : 'text-brand-orange'}`}>
                <div class={`w-3 h-3 rounded-full ${m.accent === 'cyan' ? 'bg-brand-cyan' : 'bg-brand-orange'}`}></div>
                <span class="font-display font-800 text-2xl">{m.year}</span>
              </div>

              <!-- Right content (even) -->
              <div class={`md:w-1/2 ${m.side === 'right' ? 'md:pl-16' : 'md:opacity-0 md:pointer-events-none md:pl-16'}`}>
                {m.side === 'right' && (
                  <div class={`glass-card p-7 border ${m.accent === 'cyan' ? 'border-brand-cyan/20 hover:border-brand-cyan/40' : 'border-brand-orange/20 hover:border-brand-orange/40'} transition-all duration-300`}>
                    <div class={`text-5xl font-display font-900 leading-none mb-2 ${m.accent === 'cyan' ? 'text-gradient-cyan' : 'text-gradient-orange'}`}>
                      {m.year}
                    </div>
                    <h3 class="font-display font-800 text-white uppercase text-2xl mb-3">{m.title}</h3>
                    <p class="text-sm text-brand-muted leading-relaxed">{m.text}</p>
                  </div>
                )}
                {m.side === 'left' && (
                  <!-- Mobile: show right cards below -->
                  <div class="md:hidden glass-card p-7 border border-white/5">
                    <h3 class="font-display font-800 text-white uppercase text-2xl mb-3">{m.title}</h3>
                    <p class="text-sm text-brand-muted leading-relaxed">{m.text}</p>
                  </div>
                )}
              </div>

            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values section -->
  <section class="py-20 bg-brand-darker">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <SectionTitle
          eyebrow="O que nos define"
          title="Os nosos valores"
          highlight="valores"
          align="center"
        />
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
            title: 'Comunidade',
            text: 'O GB Lorchos é ante todo unha familia. Acollemos a xente de todos os niveis, orixes e idades. A forza do colectivo é o noso mellor xogador.',
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
            title: 'Excelencia',
            text: 'Competimos para gañar, pero nunca perdemos de vista que o importante é mellorar cada día. O compromiso coa excelencia define cada adestramento e cada partido.',
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
            title: 'Identidade',
            text: 'Somos galegos e gaélicos ao mesmo tempo. A nosa identidade bebe de dúas culturas atlánticas irmás. O noso campo, a nosa lingua, o noso escudo.',
          },
        ].map(({ icon, title, text }) => (
          <div class="reveal glass-card p-8 text-center glow-card-cyan">
            <div class="w-16 h-16 rounded-2xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center mx-auto mb-6 text-brand-cyan"
                 set:html={icon}>
            </div>
            <h3 class="font-display font-800 text-white uppercase text-2xl mb-3">{title}</h3>
            <p class="text-sm text-brand-muted leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="font-display font-900 text-white uppercase text-4xl mb-4">
        Escribe o próximo capítulo
      </h3>
      <p class="text-brand-muted mb-8">A historia do GB Lorchos séguese escribindo. Únete e forma parte dela.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Button href="/contacto" variant="primary" size="lg">Únete ao club</Button>
        <Button href="/xogadores" variant="secondary" size="lg">Coñece o plantel</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }}),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
