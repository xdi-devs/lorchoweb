---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import NewsCard from '../../components/NewsCard.astro';
import MatchCard from '../../components/MatchCard.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

// Fetch data
const allNews    = await getCollection('news');
const allMatches = await getCollection('matches');

const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcomingMatches = allMatches
  .filter(m => !m.data.result && new Date(m.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 1);

const recentResults = allMatches
  .filter(m => !!m.data.result)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const nextMatch = upcomingMatches[0];
---

<BaseLayout
  title="GB Lorchos — Fútbol Gaélico en Galicia"
  description="Club de fútbol gaélico do Barbanza. Competición masculina e feminina. Somos Lorchos. Somos Lorchas."
>

  <!-- ══════════════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col justify-center pt-16 overflow-hidden">
    <!-- Background layers -->
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 hero-grid opacity-60"></div>
    <!-- Cyan orb -->
    <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] rounded-full bg-brand-cyan/5 blur-[120px] pointer-events-none"></div>
    <!-- Orange orb -->
    <div class="absolute bottom-1/3 left-1/4 w-[400px] h-[400px] rounded-full bg-brand-orange/5 blur-[100px] pointer-events-none"></div>

    <!-- Diagonal accent line -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 w-1/2 h-full"
        style="background: linear-gradient(135deg, transparent 50%, rgba(0,205,255,0.03) 50%)">
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Left: copy -->
        <div class="reveal">
          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-cyan/20 bg-brand-cyan/5 text-brand-cyan text-xs font-mono tracking-widest uppercase mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
            Barbanza · Galicia · Irlanda
          </div>

          <!-- Headline -->
          <h1 class="font-display font-900 uppercase leading-none mb-6"
              style="font-size: clamp(3.5rem, 9vw, 7rem);">
            <span class="block text-white">Somos</span>
            <span class="block text-gradient-cyan">Lorchos</span>
          </h1>

          <p class="text-brand-muted text-lg leading-relaxed max-w-lg mb-10">
            O clube de fútbol gaélico do Barbanza ao mundo.
            Competición masculina e feminina. Benvido á familia gaélica galega.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-4">
            <Button href="/xogadores" variant="primary" size="lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Ver o plantel
            </Button>
            <Button href="/calendario" variant="secondary" size="lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Calendario
            </Button>
          </div>

          <!-- Quick stats -->
          <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10">
            {[
              { value: '2016', label: 'Ano de fundación' },
              { value: '2',    label: 'Equipos activos' },
              { value: '40+',  label: 'Xogadores/as' },
            ].map(stat => (
              <div>
                <div class="font-display font-800 text-white text-3xl leading-none">{stat.value}</div>
                <div class="text-xs text-brand-muted mt-1 uppercase tracking-wide">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: next match countdown -->
        <div class="reveal animate-delay-200">
          {nextMatch ? (
            <div class="glass-card glow-card-cyan p-8 relative overflow-hidden">
              <!-- Corner accent -->
              <div class="absolute top-0 right-0 w-32 h-32 bg-brand-cyan/5 rounded-bl-[3rem]"></div>

              <div class="section-eyebrow text-brand-cyan mb-4">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
                Próximo partido
              </div>

              <div class="flex items-center justify-between mb-8">
                <div>
                  <div class="text-sm text-brand-muted mb-1">
                    {new Intl.DateTimeFormat('gl-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(nextMatch.data.date))}
                    {nextMatch.data.time && ` · ${nextMatch.data.time}h`}
                  </div>
                  <div class="font-display font-800 text-white text-2xl uppercase">
                    GB {nextMatch.data.team} vs {nextMatch.data.opponent}
                  </div>
                  <div class="text-sm text-brand-muted mt-1 flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {nextMatch.data.venue}
                  </div>
                </div>
              </div>

              <!-- Countdown -->
              <div id="countdown-container" class="grid grid-cols-4 gap-3 mb-8">
                {['dias', 'horas', 'min', 'seg'].map(unit => (
                  <div class="countdown-box">
                    <span id={`countdown-${unit}`} class="font-display font-800 text-brand-cyan text-3xl leading-none">
                      --
                    </span>
                    <span class="text-[10px] text-brand-muted uppercase tracking-widest mt-1">{unit}</span>
                  </div>
                ))}
              </div>

              <div class="flex gap-3">
                <Button href="/calendario" variant="primary" size="sm" class="flex-1 justify-center">
                  Ver calendario
                </Button>
                <Button href="/contacto" variant="secondary" size="sm" class="flex-1 justify-center">
                  Ir ao partido
                </Button>
              </div>
            </div>
          ) : (
            <!-- Fallback decorative card -->
            <div class="glass-card p-10 text-center">
              <div class="font-display text-6xl font-900 text-gradient-cyan uppercase mb-4">GAA</div>
              <p class="text-brand-muted">Non hai partidos próximos confirmados. Síguenos nas redes para estar ao tanto.</p>
              <div class="mt-6">
                <Button href="/contacto" variant="primary">Únete ao club</Button>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-brand-dark to-transparent"></div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-brand-muted animate-float">
      <span class="text-xs font-mono tracking-widest uppercase">Desprazarse</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       TICKER TAPE
  ═══════════════════════════════════════════════════════════════════════ -->
  <div class="py-4 border-y border-white/5 bg-brand-darker overflow-hidden">
    <div class="ticker-wrapper">
      <div class="ticker-inner gap-12 items-center">
        {Array(2).fill(null).map(() =>
          ['⬡ SOMOS LORCHOS', '⬡ SOMOS LORCHAS', '⬡ FÚTBOL GAÉLICO', '⬡ BARBANZA · GALICIA', '⬡ LIGA GALEGA', '⬡ COPA GALICIA', '⬡ GAA', '⬡ SOMOS LORCHOS', '⬡ SOMOS LORCHAS'].map(item => (
            <span class="text-xs font-mono tracking-[0.3em] text-brand-cyan/50 uppercase mx-8 shrink-0">
              {item}
            </span>
          ))
        )}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════
       LORCHOS vs LORCHAS  
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-slate/20 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-16 reveal">
        <SectionTitle
          eyebrow="Os nosos equipos"
          title="Lorchos e Lorchas"
          highlight="Lorchos & Lorchas"
          subtitle="Dous equipos, un só espírito."
          align="center"
        />
      </div>

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        <!-- Lorchos card -->
        <div class="reveal group relative rounded-4xl overflow-hidden border border-brand-cyan/20 hover:border-brand-cyan/40 transition-all duration-500 cursor-pointer" onclick="window.location='/xogadores?team=lorchos'">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand-slate to-brand-dark"></div>
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
               style="background: radial-gradient(ellipse at 30% 50%, rgba(0,205,255,0.12) 0%, transparent 60%)"></div>
          <!-- Big number decoration -->
          <div class="absolute -right-8 -bottom-12 font-display font-900 text-[12rem] leading-none text-brand-cyan/5 select-none pointer-events-none">M</div>

          <div class="relative z-10 p-10 lg:p-14">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-cyan/30 bg-brand-cyan/10 text-brand-cyan text-xs font-mono tracking-widest uppercase mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
              Masculino
            </div>
            <h2 class="font-display font-900 text-white uppercase leading-none mb-4"
                style="font-size: clamp(3rem, 6vw, 5rem);">
              GB<br/><span class="text-gradient-cyan">Lorchos</span>
            </h2>
            <p class="text-brand-muted text-base leading-relaxed max-w-sm mb-8">
              O equipo masculino de GB Lorchos compite na Liga Galega.
              Formación, compromiso e paixón polo fútbol gaélico.
            </p>
            <p class="font-display text-xl font-700 text-white/40 uppercase tracking-[0.3em] italic mb-8">
              "Somos Lorchos"
            </p>
            <Button href="/xogadores?team=lorchos" variant="primary">
              Ver plantel masculino
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </Button>
          </div>
        </div>

        <!-- Lorchas card -->
        <div class="reveal animate-delay-200 group relative rounded-4xl overflow-hidden border border-brand-orange/20 hover:border-brand-orange/40 transition-all duration-500 cursor-pointer" onclick="window.location='/xogadores?team=lorchas'">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand-slate to-brand-dark"></div>
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
               style="background: radial-gradient(ellipse at 70% 50%, rgba(245,138,32,0.12) 0%, transparent 60%)"></div>
          <!-- Big letter decoration -->
          <div class="absolute -right-8 -bottom-12 font-display font-900 text-[12rem] leading-none text-brand-orange/5 select-none pointer-events-none">F</div>

          <div class="relative z-10 p-10 lg:p-14">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-orange/30 bg-brand-orange/10 text-brand-orange text-xs font-mono tracking-widest uppercase mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-pulse"></span>
              Feminino
            </div>
            <h2 class="font-display font-900 text-white uppercase leading-none mb-4"
                style="font-size: clamp(3rem, 6vw, 5rem);">
              GB<br/><span class="text-gradient-orange">Lorchas</span>
            </h2>
            <p class="text-brand-muted text-base leading-relaxed max-w-sm mb-8">
              O equipo feminino do Barbanza.
              Valentía, talento e forza galega no campo.
            </p>
            <p class="font-display text-xl font-700 text-white/40 uppercase tracking-[0.3em] italic mb-8">
              "Somos Lorchas"
            </p>
            <Button href="/xogadores?team=lorchas" variant="orange">
              Ver plantel feminino
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       ÚLTIMAS NOTICIAS
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14">
        <div class="reveal">
          <SectionTitle
            eyebrow="Actualidade"
            title="Últimas Noticias"
            highlight="Noticias"
          />
        </div>
        <Button href="/noticias" variant="ghost" size="sm" class="reveal animate-delay-200 shrink-0">
          Ver todas as noticias
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </Button>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestNews.map((article, i) => (
          <div class={`reveal animate-delay-${(i+1)*100}`}>
            <NewsCard
              title={article.data.title}
              description={article.data.description}
              date={article.data.date}
              image={article.data.image}
              category={article.data.category}
              slug={article.slug}
              featured={article.data.featured}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       ÚLTIMOS RESULTADOS
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="py-24 bg-brand-darker relative overflow-hidden">
    <div class="absolute inset-0"
         style="background: radial-gradient(ellipse at 20% 50%, rgba(0,205,255,0.04) 0%, transparent 60%)">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14">
        <div class="reveal">
          <SectionTitle
            eyebrow="Resultados recentes"
            title="Últimos Partidos"
            highlight="Partidos"
          />
        </div>
        <Button href="/calendario" variant="ghost" size="sm" class="reveal animate-delay-200 shrink-0">
          Calendario completo
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </Button>
      </div>

      <div class="flex flex-col gap-3">
        {recentResults.length > 0 ? recentResults.map((match, i) => (
          <div class={`reveal animate-delay-${(i+1)*100}`}>
            <MatchCard
              date={match.data.date}
              time={match.data.time}
              opponent={match.data.opponent}
              venue={match.data.venue}
              isHome={match.data.isHome}
              competition={match.data.competition}
              team={match.data.team}
              result={match.data.result}
            />
          </div>
        )) : (
          <p class="text-brand-muted text-center py-12">Non hai resultados recentes.</p>
        )}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       ÚNETE CTA BANNER
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal relative rounded-5xl overflow-hidden border border-brand-cyan/20 p-12 lg:p-20 text-center"
           style="background: linear-gradient(135deg, #0d1520 0%, #0a1828 50%, #0d1520 100%)">
        <!-- Background glows -->
        <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full bg-brand-cyan/8 blur-[80px] pointer-events-none"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 rounded-full bg-brand-orange/5 blur-[80px] pointer-events-none"></div>

        <!-- Corner decorations -->
        <div class="absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-brand-cyan/40 rounded-tl-lg"></div>
        <div class="absolute top-6 right-6 w-8 h-8 border-t-2 border-r-2 border-brand-cyan/40 rounded-tr-lg"></div>
        <div class="absolute bottom-6 left-6 w-8 h-8 border-b-2 border-l-2 border-brand-cyan/40 rounded-bl-lg"></div>
        <div class="absolute bottom-6 right-6 w-8 h-8 border-b-2 border-r-2 border-brand-cyan/40 rounded-br-lg"></div>

        <div class="relative z-10">
          <span class="section-eyebrow justify-center">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-pulse"></span>
            Únete á familia
          </span>
          <h2 class="font-display font-900 uppercase text-white leading-none mb-6"
              style="font-size: clamp(3rem, 7vw, 6rem);">
            Forma parte do<br/>
            <span class="text-gradient-cyan">GB Lorchos</span>
          </h2>
          <p class="text-brand-muted text-lg max-w-xl mx-auto mb-10">
            Adestramentos en Bealo os luns, mércores e venres. Non se require experiencia previa.
            O fútbol gaélico é para todos e todas.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <Button href="/contacto" variant="primary" size="lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
              Quero unirme
            </Button>
            <Button href="/historia" variant="secondary" size="lg">
              A nosa historia
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       PATROCINADORES
  ═══════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-xs font-mono text-brand-muted/50 uppercase tracking-[0.3em] mb-10">
        Patrocinadores e colaboradores
      </p>
      <div class="flex flex-wrap items-center justify-center gap-10 lg:gap-16">
        {['Concello de Boiro', 'Futgal', 'GAA', 'Gaélico Galego', 'Galicia Bealo'].map(sponsor => (
          <div class="text-brand-muted/30 hover:text-brand-muted/60 transition-colors duration-300 font-display font-700 text-lg uppercase tracking-wider">
            {sponsor}
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script define:vars={{ nextMatchDate: nextMatch?.data.date ?? null, nextMatchTime: nextMatch?.data.time ?? null }}>
  // ── Countdown ──
  if (nextMatchDate) {
    const targetStr = nextMatchTime
      ? `${nextMatchDate}T${nextMatchTime}:00`
      : `${nextMatchDate}T12:00:00`;
    const target = new Date(targetStr);

    function pad(n) { return String(n).padStart(2, '0'); }

    function updateCountdown() {
      const now  = new Date();
      const diff = target - now;
      if (diff <= 0) {
        ['dias','horas','min','seg'].forEach(u => {
          const el = document.getElementById(`countdown-${u}`);
          if (el) el.textContent = '00';
        });
        return;
      }
      const dias  = Math.floor(diff / 86400000);
      const horas = Math.floor((diff % 86400000) / 3600000);
      const min   = Math.floor((diff % 3600000)  / 60000);
      const seg   = Math.floor((diff % 60000)    / 1000);

      const dEl = document.getElementById('countdown-dias');
      const hEl = document.getElementById('countdown-horas');
      const mEl = document.getElementById('countdown-min');
      const sEl = document.getElementById('countdown-seg');

      if (dEl) dEl.textContent = pad(dias);
      if (hEl) hEl.textContent = pad(horas);
      if (mEl) mEl.textContent = pad(min);
      if (sEl) sEl.textContent = pad(seg);
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  // ── Scroll reveal ──
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
