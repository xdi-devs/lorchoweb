---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'GB Lorchos — Fútbol Gaélico en Galicia',
  description = 'Club de fútbol gaélico asentado no Barbanza. Somos Lorchos. Somos Lorchas.',
  image = '/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://lorchos.gal');
const fullTitle = title.includes('GB Lorchos') ? title : `${title} | GB Lorchos`;

const navLinks = [
  { href: '/',            label: 'Inicio'      },
  { href: '/xogadores',   label: 'Xogadores/as' },
  { href: '/calendario',  label: 'Calendario'  },
  { href: '/historia',    label: 'Historia'    },
  { href: '/contacto',    label: 'Contacto'    },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="gl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#080c12" />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Primary Meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(image, Astro.site ?? 'https://lorchos.gal')} />
  <meta property="og:locale"      content="gl_ES" />
  <meta property="og:site_name"   content="GB Lorchos" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(image, Astro.site ?? 'https://lorchos.gal')} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
    rel="stylesheet"
  />

  <!-- Favicon SVG inline -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="bg-brand-dark text-white font-body antialiased overflow-x-hidden">

  <!-- ══ NAVBAR ══════════════════════════════════════════════════════════════ -->
  <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <nav class="glass-nav border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-18">

          <!-- Logo -->
          <a href="/" class="flex items-center gap-3 group" aria-label="GB Lorchos — Inicio">
            <div class="relative">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-cyan to-brand-cyan/60 flex items-center justify-center shadow-cyan group-hover:shadow-cyan transition-all duration-300">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="text-brand-dark">
                  <!-- Gaelic football stylized icon -->
                  <ellipse cx="12" cy="12" rx="9" ry="10" stroke="currentColor" stroke-width="2" fill="none"/>
                  <line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 8 Q12 10 21 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  <path d="M3 16 Q12 14 21 16" stroke="currentColor" stroke-width="1.5" fill="none"/>
                </svg>
              </div>
            </div>
            <div class="flex flex-col leading-none">
              <span class="font-display text-xl font-800 tracking-wider text-white">GB LORCHOS</span>
              <span class="text-[10px] font-mono text-brand-cyan/70 tracking-[0.2em] uppercase">Fútbol Gaélico</span>
            </div>
          </a>

          <!-- Desktop nav -->
          <ul class="hidden lg:flex items-center gap-1">
            {navLinks.map(({ href, label }) => {
              const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
              return (
                <li>
                  <a
                    href={href}
                    class={`
                      relative px-4 py-2 rounded-lg font-body font-medium text-sm transition-all duration-200
                      ${isActive
                        ? 'text-brand-cyan'
                        : 'text-white/70 hover:text-white hover:bg-white/5'
                      }
                    `}
                  >
                    {isActive && (
                      <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-brand-cyan rounded-full"></span>
                    )}
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- CTA + Mobile menu toggle -->
          <div class="flex items-center gap-3">
            <a
              href="/contacto"
              class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-cyan text-brand-dark font-semibold text-sm hover:bg-brand-cyan/90 transition-all duration-200 shadow-cyan hover:shadow-cyan"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
              </svg>
              Únete
            </a>

            <!-- Mobile hamburger -->
            <button
              id="mobile-menu-toggle"
              aria-label="Abrir menú"
              aria-expanded="false"
              class="lg:hidden p-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors"
            >
              <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
              <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile dropdown -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/5 bg-brand-darker/95 backdrop-blur-xl">
        <ul class="px-4 py-4 flex flex-col gap-1">
          {navLinks.map(({ href, label }) => {
            const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
            return (
              <li>
                <a
                  href={href}
                  class={`block px-4 py-3 rounded-xl font-medium text-sm transition-all
                    ${isActive
                      ? 'bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20'
                      : 'text-white/70 hover:text-white hover:bg-white/5'
                    }
                  `}
                >
                  {label}
                </a>
              </li>
            );
          })}
          <li class="pt-2 border-t border-white/10 mt-2">
            <a href="/contacto" class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-brand-cyan text-brand-dark font-semibold text-sm">
              Únete ao Club
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- ══ MAIN ════════════════════════════════════════════════════════════════ -->
  <main>
    <slot />
  </main>

  <!-- ══ FOOTER ══════════════════════════════════════════════════════════════ -->
  <footer class="relative mt-24 border-t border-white/5 bg-brand-darker">
    <!-- Glow accent -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-px bg-gradient-to-r from-transparent via-brand-cyan/50 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-12">

        <!-- Brand -->
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-cyan to-brand-cyan/60 flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-brand-dark">
                <ellipse cx="12" cy="12" rx="9" ry="10" stroke="currentColor" stroke-width="2" fill="none"/>
                <line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.5"/>
                <path d="M3 8 Q12 10 21 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M3 16 Q12 14 21 16" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div>
              <div class="font-display text-lg font-800 tracking-wider">GB LORCHOS</div>
              <div class="text-[10px] text-brand-cyan/60 tracking-widest uppercase font-mono">Ourense · Galicia</div>
            </div>
          </div>
          <p class="text-sm text-brand-muted leading-relaxed">
            Club de fútbol gaélico asentado no Barbanza. Competimos, formamos e vivimos o deporte gaélico dende a costa galega.
          </p>
          <!-- Social links -->
          <div class="flex items-center gap-3 mt-6">
            <a href="https://instagram.com/gblorchos" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
            <a href="https://youtube.com/@gblorchos" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
              </svg>
            </a>
            <a href="https://whatsapp.com/channel/gblorchos" target="_blank" rel="noopener noreferrer" aria-label="Canal de WhatsApp" class="social-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Nav links -->
        <div>
          <h3 class="footer-heading">Navegación</h3>
          <ul class="space-y-3">
            {navLinks.map(({ href, label }) => (
              <li><a href={href} class="footer-link">{label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Club -->
        <div>
          <h3 class="footer-heading">O Club</h3>
          <ul class="space-y-3">
            <li><a href="/historia"   class="footer-link">A nosa historia</a></li>
            <li><a href="/xogadores"  class="footer-link">Plantel masculino</a></li>
            <li><a href="/xogadoras" class="footer-link">Plantel feminino</a></li>
            <li><a href="/calendario" class="footer-link">Próximos partidos</a></li>
            <li><a href="/contacto"   class="footer-link">Únete ao club</a></li>
          </ul>
        </div>

        <!-- Contacto rápido -->
        <div>
          <h3 class="footer-heading">Contacto</h3>
          <ul class="space-y-3 text-sm text-brand-muted">
            <li class="flex items-start gap-2">
              <svg class="shrink-0 mt-0.5 text-brand-cyan" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Barbanza, Galicia</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="shrink-0 mt-0.5 text-brand-cyan" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <a href="mailto:info@gblorchos.gal" class="hover:text-white transition-colors">info@gblorchos.gal</a>
            </li>
          </ul>
          <div class="mt-6 p-4 rounded-2xl bg-brand-cyan/5 border border-brand-cyan/10">
            <p class="text-xs text-brand-muted">Adestramentos</p>
            <p class="text-sm font-semibold text-white mt-1">Luns, mércores e venres · 20:00 h</p>
            <p class="text-xs text-brand-muted mt-0.5">Campo de fútbol de Bealo</p>
          </div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="mt-16 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-brand-muted">
          © {new Date().getFullYear()} GB Lorchos. Todos os dereitos reservados.
        </p>
        <div class="flex items-center gap-1 text-xs text-brand-muted">
          <span>Feito con</span>
          <span class="text-brand-orange">♥</span>
          <span>en Boiro · Galicia</span>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>

<script>
  // ── Navbar scroll effect ──
  const navbar = document.getElementById('navbar');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 80) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
    lastScroll = scrollY;
  }, { passive: true });

  // ── Mobile menu toggle ──
  const toggle   = document.getElementById('mobile-menu-toggle');
  const menu     = document.getElementById('mobile-menu');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (!isOpen) {
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });
</script>
